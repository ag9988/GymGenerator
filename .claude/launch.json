      "port": 3456
    },
    {
      "name": "gantt-chart",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "3457", "gantt"],
      "port": 3457
    },
    {
      "name": "chord-generator",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "3458", "chord-generator"],
      "port": 3458
    },
    {
      "name": "gym-app",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "3459", "gym planning"],
